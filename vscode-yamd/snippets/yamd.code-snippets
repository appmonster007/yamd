{
  "Kanban board": { "prefix": "kanban", "description": "A board with three columns", "body": ["```kanban ${1:board}", "## ${2:Todo}", "- [ ] ${3:First card}", "", "## ${4:Doing}", "", "## ${5:Done}", "```", "$0"] },
  "Calendar": { "prefix": "calendar", "description": "A calendar of events", "body": ["```calendar ${1:plan}", "- [ ] ${2:Event} {due=${3:2026-01-01}}", "```", "$0"] },
  "Timeline": { "prefix": "timeline", "description": "A timeline with lanes", "body": ["```timeline ${1:roadmap}", "## ${2:Lane}", "- [ ] ${3:Item} {start=${4:2026-01-01} due=${5:2026-02-01}}", "```", "$0"] },
  "Gallery": { "prefix": "gallery", "description": "A grid of images", "body": ["```gallery ${1:photos}", "- ![${2:Caption}](${3:image.png})", "```", "$0"] },
  "Query": { "prefix": ["query", "sql"], "description": "A read-only SQL query over a data file", "body": ["```sql", "-- id=\"${1:query}\" source=\"${2:data.csv}\" view=\"${3|table,board,chart|}\"", "SELECT ${4:*} FROM ${5:data};", "```", "$0"] },
  "Callout": { "prefix": "callout", "description": "A callout", "body": ["> [!${1|note,tip,important,warning,caution,danger|}] ${2:Title}", "> $0"] },
  "Theorem": { "prefix": "theorem", "description": "A numbered theorem with a reference id", "body": ["> [!theorem] ${1:Name} ^thm-${2:name}", "> $0"] },
  "Definition": { "prefix": "definition", "description": "A numbered definition with a reference id", "body": ["> [!definition] ${1:Term} ^def-${2:term}", "> $0"] },
  "Flashcard": { "prefix": "card", "description": "A flashcard: the title is the question", "body": ["> [!card] ${1:Question?}", "> ${2:Answer}", "$0"] },
  "Table of contents": { "prefix": "toc", "description": "A generated table of contents", "body": ["<!-- yamd:toc depth=${1:3} -->", "<!-- /yamd:toc -->", "$0"] },
  "Bibliography": { "prefix": "bibliography", "description": "A generated reference list", "body": ["<!-- yamd:bibliography -->", "<!-- /yamd:bibliography -->", "$0"] },
  "Page break": { "prefix": "pagebreak", "description": "Start a new page when printed", "body": ["<!-- yamd:pagebreak -->", "$0"] },
  "Figure": { "prefix": "figure", "description": "An image with a target to refer to", "body": ["![${1:Caption}](${2:image.png})", "", "^fig-${3:name}", "$0"] },
  "Table with target": { "prefix": "tabletarget", "description": "A table with a caption and a target", "body": ["Table: ${1:Caption}", "", "| ${2:A} | ${3:B} |", "| --- | --- |", "|  |  |", "", "^tbl-${4:name}", "$0"] },
  "Equation with target": { "prefix": "equation", "description": "A display equation with a target", "body": ["$$", "${1:E = mc^2}", "$$", "", "^eq-${2:name}", "$0"] },
  "Mermaid diagram": { "prefix": "mermaid", "description": "A diagram drawn from text", "body": ["```mermaid", "flowchart LR", "  ${1:A} --> ${2:B}", "```", "$0"] },
  "Review: insert": { "prefix": "ins", "description": "Suggest added text", "body": ["<ins>${1:added}</ins>$0"] },
  "Review: delete": { "prefix": "del", "description": "Suggest removed text", "body": ["<del>${1:removed}</del>$0"] }
}
