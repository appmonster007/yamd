{
  "Front matter": {
    "prefix": "frontmatter",
    "body": ["---", "yamd: 0.1", "title: ${1:Title}", "author: ${2:Author}", "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}", "lang: ${3:en-US}", "---", "", "$0"],
    "description": "YAML front matter with the reserved keys"
  },
  "Note callout": {
    "prefix": "note",
    "body": [":::note", "${1:Text}", ":::", "$0"],
    "description": "Note callout"
  },
  "Tip callout": {
    "prefix": "tip",
    "body": [":::tip", "${1:Text}", ":::", "$0"],
    "description": "Tip callout"
  },
  "Warning callout": {
    "prefix": "warning",
    "body": [":::warning {title=\"${1:Title}\"}", "${2:Text}", ":::", "$0"],
    "description": "Warning callout with a title"
  },
  "Danger callout": {
    "prefix": "danger",
    "body": [":::danger", "${1:Text}", ":::", "$0"],
    "description": "Danger callout"
  },
  "Collapsible section": {
    "prefix": "details",
    "body": [":::details {summary=\"${1:Summary}\"}", "${2:Hidden content}", ":::", "$0"],
    "description": "Collapsible section"
  },
  "Columns": {
    "prefix": "columns",
    "body": ["::::columns", ":::column", "${1:Left}", ":::", ":::column", "${2:Right}", ":::", "::::", "$0"],
    "description": "Two-column layout"
  },
  "List table": {
    "prefix": "listtable",
    "body": [
      ":::table {header=1 caption=\"${1:Caption}\"}",
      "- - ${2:Header 1}",
      "  - ${3:Header 2}",
      "- - ${4:Cell}",
      "  - ${5:Cell}",
      ":::",
      "$0"
    ],
    "description": "List table for multi-line cells"
  },
  "Pipe table": {
    "prefix": "table",
    "body": ["| ${1:Column} | ${2:Column} |", "| --- | --- |", "| ${3:Cell} | ${4:Cell} |", "$0"],
    "description": "Pipe table with a header row"
  },
  "Code block": {
    "prefix": "code",
    "body": ["```${1:language}", "${2:code}", "```", "$0"],
    "description": "Fenced code block"
  },
  "Math block": {
    "prefix": "math",
    "body": ["$$ {#eq:${1:label}}", "${2:E = mc^2}", "$$", "$0"],
    "description": "Numbered math block"
  },
  "Figure": {
    "prefix": "figure",
    "body": ["![${1:Alt text}](${2:path/to/image.png}){caption=\"${3:Caption}\" #fig:${4:label}}", "$0"],
    "description": "Image with a numbered caption"
  },
  "Insert suggestion": {
    "prefix": "ins",
    "body": ["{++${1:added text}++}$0"],
    "description": "Review markup: insertion"
  },
  "Delete suggestion": {
    "prefix": "del",
    "body": ["{--${1:removed text}--}$0"],
    "description": "Review markup: deletion"
  },
  "Substitution suggestion": {
    "prefix": "sub",
    "body": ["{~~${1:old}~>${2:new}~~}$0"],
    "description": "Review markup: substitution"
  },
  "Review comment": {
    "prefix": "comment",
    "body": ["{==${1:text}==}{>>${2:comment}<<}$0"],
    "description": "Review markup: highlight with a comment"
  },
  "Table of contents": {
    "prefix": "toc",
    "body": ["::toc{depth=${1:2}}", "$0"],
    "description": "Table of contents"
  }
}
