{
  "comments": {
    "blockComment": ["%%", "%%"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "`", "close": "`", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["`", "`"],
    ["*", "*"],
    ["~", "~"],
    ["=", "="],
    ["+", "+"],
    ["\"", "\""],
    ["$", "$"]
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "folding": {
    "markers": {
      "start": "^\\s*(:{3,})\\s*[A-Za-z]",
      "end": "^\\s*:{3,}\\s*$"
    }
  },
  "wordPattern": "(\\p{Alphabetic}|\\p{Number}|\\p{Nonspacing_Mark})(((\\p{Alphabetic}|\\p{Number}|\\p{Nonspacing_Mark})|[_'’-])*(\\p{Alphabetic}|\\p{Number}|\\p{Nonspacing_Mark}))?"
}
