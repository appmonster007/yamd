      "explorer/context": [
        {
          "command": "yamd.newStudyNote",
          "group": "yamd@1",
          "when": "explorerResourceIsFolder || explorerResourceIsRoot"
        },
        {
          "command": "yamd.newNote",
          "when": "explorerResourceIsFolder || explorerResourceIsRoot",
          "group": "yamd@0"
        }
      ],
      "view/title": [
        {
          "command": "yamd.reviewCards",
          "when": "view == yamd.cards",
          "group": "navigation"
        },
        {
          "command": "yamd.insertWidget",
          "when": "view == yamd.widgets",
          "group": "navigation"
        },
        {
          "command": "yamd.openDashboard",
          "when": "view == yamd.study",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "yamd.recordAudio",
          "when": "editorLangId == markdown",
          "group": "yamd@1"
        }
      ]
    },
    "configuration": {
      "title": "YAMD",
      "properties": {
        "yamd.study.newCardsPerDay": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Maximum number of new (unseen) flashcards shown per review session."
        },
        "yamd.study.pomodoroMinutes": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "description": "Default study-timer session length in minutes."
        },
        "yamd.study.staleAfterDays": {
          "type": "number",
          "default": 14,
          "minimum": 1,
          "description": "Number of days without a review before a topic is considered stale in the dashboard."
        },
        "yamd.build.onSave": {
          "type": "boolean",
          "default": false,
          "description": "Run YAMD: Build whenever a Markdown note is saved. Build only changes reference labels and the content between <!-- yamd:… --> markers."
        },
        "yamd.build.linkCitations": {
          "type": "boolean",
          "default": true,
          "description": "When Build runs, turn citations like [@smith2020] into links to their entry in the bibliography (and keep their labels current)."
        },
        "yamd.audio.folder": {
          "type": "string",
          "default": "audio",
          "description": "Folder, relative to the note, where YAMD: Record Audio and Add Link saves recordings. It must be inside the note's folder."
        },
        "yamd.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a YAMD button in the status bar while a Markdown note is open. It opens the YAMD menu."
        },
        "yamd.queries.refreshOnSave": {
          "type": "boolean",
          "default": false,
          "description": "When a note is saved, refresh the result snapshots under query blocks that already have one."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yamd",
          "title": "YAMD",
          "icon": "media/yamd-activity.svg"
        }
      ]
    },
    "views": {
      "yamd": [
        {
          "id": "yamd.widgets",
          "name": "Widgets in This Note"
        },
        {
          "id": "yamd.outline",
          "name": "Callouts and References"
        },
        {
          "id": "yamd.cards",
          "name": "Flashcards"
        },
        {
          "id": "yamd.deadlines",
          "name": "Deadlines"
        },
        {
          "id": "yamd.study",
          "name": "Study and Data Files"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "yamd.widgets",
        "contents": "This note has no widget blocks, or no Markdown note is open.\n[Insert Widget](command:yamd.insertWidget)"
      },
      {
        "view": "yamd.outline",
        "contents": "No callouts or figure, table and equation targets in this note.\nWrite a callout as `> [!theorem] Title`."
      },
      {
        "view": "yamd.cards",
        "contents": "No flashcards yet. Write one as `> [!card] Question` with the answer on the next lines.\n[New Study Note](command:yamd.newStudyNote)"
      },
      {
        "view": "yamd.deadlines",
        "contents": "No deadlines. Add `{due=YYYY-MM-DD}` to a task."
      }
    ],
    "walkthroughs": [
      {
        "id": "yamd.start",
        "title": "Get started with YAMD",
        "description": "Boards, queries, references and voice notes in plain Markdown.",
        "steps": [
          {
            "id": "sample",
            "title": "Create a sample note",
            "description": "Make a note that uses each part of YAMD once.\n[Create Sample Note](command:yamd.createSampleNote)",
            "media": {
              "markdown": "media/walkthrough/sample.md"
            },
            "completionEvents": [
              "onCommand:yamd.createSampleNote"
            ]
          },
          {
            "id": "widget",
            "title": "Open a widget",
            "description": "Open a block as a draggable board beside the note.\n[Open Widget](command:yamd.openWidget)",
            "media": {
              "markdown": "media/walkthrough/widget.md"
            },
            "completionEvents": [
              "onCommand:yamd.openWidget"
            ]
          },
          {
            "id": "query",
            "title": "Run a query",
            "description": "Read a CSV, JSON or SQLite file with SQL.\n[Insert Query](command:yamd.insertQuery)",
            "media": {
              "markdown": "media/walkthrough/query.md"
            },
            "completionEvents": [
              "onCommand:yamd.insertQuery",
              "onCommand:yamd.runQuery"
            ]
          },
          {
            "id": "build",
            "title": "Build references",
            "description": "Turn `[@id]` into numbered links and fill the contents.\n[Build](command:yamd.build)",
            "media": {
              "markdown": "media/walkthrough/build.md"
            },
            "completionEvents": [
              "onCommand:yamd.build"
            ]
          },
          {
            "id": "audio",
            "title": "Record a voice note",
            "description": "Save a recording next to the note and link it.\n[Record Audio](command:yamd.recordAudio)",
            "media": {
              "markdown": "media/walkthrough/audio.md"
            },
            "completionEvents": [
              "onCommand:yamd.recordAudio"
            ]
          },
          {
            "id": "menu",
            "title": "Find everything in the menu",
            "description": "One list of what YAMD can do.\n[Open the Menu](command:yamd.menu)",
            "media": {
              "markdown": "media/walkthrough/menu.md"
            },
            "completionEvents": [
              "onCommand:yamd.menu"
            ]
          }
        ]
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/yamd.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "package": "npm run typecheck && npm test && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test:integration": "node scripts/integration.mjs"
  },
