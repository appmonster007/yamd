{
  "name": "vscode-yamd-ext",
  "displayName": "YAMD Studio",
  "description": "Markdown widgets for VS Code: kanban boards, calendars, timelines, galleries and SQL query views in fenced blocks, callouts, citations, a generated table of contents and bibliography, HTML/slide export and study tools.",
  "version": "1.2.0",
  "publisher": "appmonster007",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/appmonster007/yamd.git",
    "directory": "vscode-yamd"
  },
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Visualization",
    "Education",
    "Other"
  ],
  "keywords": [
    "markdown",
    "kanban",
    "calendar",
    "timeline",
    "sql",
    "callout",
    "citation",
    "flashcards"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/*.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "yamd.reviewCards",
        "title": "Review Flashcards",
        "category": "YAMD"
      },
      {
        "command": "yamd.openDashboard",
        "title": "Open Study Dashboard",
        "category": "YAMD"
      },
      {
        "command": "yamd.startStudyTimer",
        "title": "Start Study Timer",
        "category": "YAMD"
      },
      {
        "command": "yamd.pauseStudyTimer",
        "title": "Pause Study Timer",
        "category": "YAMD"
      },
      {
        "command": "yamd.stopStudyTimer",
        "title": "Stop Study Timer",
        "category": "YAMD"
      },
      {
        "command": "yamd.newStudyNote",
        "title": "New Study Note…",
        "category": "YAMD"
      },
      {
        "command": "yamd.exportHtml",
        "title": "Export as HTML",
        "category": "YAMD"
      },
      {
        "command": "yamd.exportPdf",
        "title": "Export as PDF",
        "category": "YAMD"
      },
      {
        "command": "yamd.exportSlides",
        "title": "Export as Slides (HTML)",
        "category": "YAMD"
      },
      {
        "command": "yamd.pruneCards",
        "title": "Prune Orphaned Card Data",
        "category": "YAMD"
      },
      {
        "command": "yamd.openWidget",
        "title": "Open Widget",
        "category": "YAMD"
      },
      {
        "command": "yamd.nameBlock",
        "title": "Name Block",
        "category": "YAMD"
      },
      {
        "command": "yamd.insertWidget",
        "title": "Insert Widget",
        "category": "YAMD"
      },
      {
        "command": "yamd.runQuery",
        "title": "Run Query (Write Snapshot)",
        "category": "YAMD"
      },
      {
        "command": "yamd.build",
        "title": "Build (Refresh Generated Sections)",
        "category": "YAMD"
      },
      {
        "command": "yamd.insertToc",
        "title": "Insert Table of Contents",
        "category": "YAMD"
      },
      {
        "command": "yamd.insertBibliography",
        "title": "Insert Bibliography",
        "category": "YAMD"
      },
      {
        "command": "yamd.goToReference",
        "title": "Go to Reference Target",
        "category": "YAMD"
      },
      {
        "command": "yamd.openAt",
        "title": "Open Note at Line",
        "category": "YAMD"
      },
      {
        "command": "yamd.openInSqlClient",
        "title": "Open Query Source in SQL Client",
        "category": "YAMD"
      },
      {
        "command": "yamd.openInSqliteEditor",
        "title": "Open in SQLite Editor",
        "category": "YAMD"
      },
      {
        "command": "yamd.openInCsvEditor",
        "title": "Open in CSV Editor",
        "category": "YAMD"
      },
      {
        "command": "yamd.openDailyNote",
        "title": "Open Daily Note (Foam)",
        "category": "YAMD"
      },
      {
        "command": "yamd.studyTimerMenu",
        "title": "Study Timer Menu",
        "category": "YAMD"
      },
      {
        "command": "yamd.queryCsvWithRbql",
        "title": "Query CSV with RBQL (Rainbow CSV)",
        "category": "YAMD"
      },
      {
        "command": "yamd.acceptChange",
        "title": "Accept Change at Cursor",
        "category": "YAMD"
      },
      {
        "command": "yamd.rejectChange",
        "title": "Reject Change at Cursor",
        "category": "YAMD"
      },
      {
        "command": "yamd.acceptAllChanges",
        "title": "Accept All Changes",
        "category": "YAMD"
      },
      {
        "command": "yamd.rejectAllChanges",
        "title": "Reject All Changes",
        "category": "YAMD"
      },
      {
        "command": "yamd.openKanban",
        "title": "Open Kanban",
        "category": "YAMD"
      },
      {
        "command": "yamd.openCalendar",
        "title": "Open Calendar",
        "category": "YAMD"
      },
      {
        "command": "yamd.openTimeline",
        "title": "Open Timeline",
        "category": "YAMD"
      },
      {
        "command": "yamd.openGallery",
        "title": "Open Gallery",
        "category": "YAMD"
      },
      {
        "command": "yamd.openQuery",
        "title": "Open Query",
        "category": "YAMD"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "yamd.exportHtml",
          "group": "yamd_export@1",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "yamd.exportPdf",
          "group": "yamd_export@2",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "yamd.exportSlides",
          "group": "yamd_export@4",
          "when": "resourceLangId == markdown"
        }
      ],
      "commandPalette": [
        {
          "command": "yamd.openWidget",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.nameBlock",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.insertWidget",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.runQuery",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.build",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.insertToc",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.insertBibliography",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.goToReference",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.openAt",
          "when": "false"
        },
        {
          "command": "yamd.acceptChange",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.rejectChange",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.acceptAllChanges",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.rejectAllChanges",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.openKanban",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.openCalendar",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.openTimeline",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.openGallery",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.openQuery",
          "when": "editorLangId == markdown"
        }
      ],
      "explorer/context": [
        {
          "command": "yamd.newStudyNote",
          "group": "yamd@1",
          "when": "explorerResourceIsFolder || explorerResourceIsRoot"
        }
      ]
    },
    "configuration": {
      "title": "YAMD",
      "properties": {
        "yamd.study.newCardsPerDay": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Maximum number of new (unseen) flashcards shown per review session."
        },
        "yamd.study.pomodoroMinutes": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "description": "Default study-timer session length in minutes."
        },
        "yamd.study.staleAfterDays": {
          "type": "number",
          "default": 14,
          "minimum": 1,
          "description": "Number of days without a review before a topic is considered stale in the dashboard."
        },
        "yamd.build.onSave": {
          "type": "boolean",
          "default": false,
          "description": "Run YAMD: Build whenever a Markdown note is saved. Build only changes reference labels and the content between <!-- yamd:… --> markers."
        },
        "yamd.build.linkCitations": {
          "type": "boolean",
          "default": true,
          "description": "When Build runs, turn citations like [@smith2020] into links to their entry in the bibliography (and keep their labels current)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yamd",
          "title": "YAMD",
          "icon": "media/yamd-activity.svg"
        }
      ]
    },
    "views": {
      "yamd": [
        {
          "id": "yamd.deadlines",
          "name": "Deadlines"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "package": "npm run typecheck && npm test && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test:integration": "node scripts/integration.mjs"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^4.0.0",
    "commonmark-spec": "^0.31.2",
    "esbuild": "^0.28.2",
    "micromark-util-types": "^2.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark": "^4.0.3",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-chunked": "^2.0.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-resolve-all": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "sql.js": "^1.12.0"
  },
  "extensionPack": [
    "foam.foam-vscode",
    "yy0931.vscode-sqlite3-editor",
    "janisdd.vscode-edit-csv",
    "mechatroner.rainbow-csv",
    "yzhang.markdown-all-in-one"
  ],
  "extensionDependencies": [
    "foam.foam-vscode"
  ]
}
