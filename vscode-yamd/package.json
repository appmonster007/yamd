{
  "name": "vscode-yamd-ext",
  "displayName": "YAMD Studio",
  "description": "Language support for YAMD: syntax highlighting, live preview, diagnostics and editing shortcuts.",
  "version": "0.1.1",
  "publisher": "appmonster007",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/appmonster007/yamd.git",
    "directory": "vscode-yamd"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "yamd",
    "markdown",
    "markup",
    "preview"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.yamd",
    "workspaceContains:**/*.ymd",
    "onLanguage:ydb",
    "onCustomEditor:yamd.editor",
    "onLanguage:markdown"
  ],
  "contributes": {
    "languages": [
      {
        "id": "yamd",
        "aliases": [
          "YAMD",
          "yamd"
        ],
        "extensions": [
          ".yamd",
          ".ymd"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ydb",
        "aliases": [
          "YAMD Database",
          "ydb"
        ],
        "extensions": [
          ".ydb"
        ]
      }
    ],
    "grammars": [
      {
        "language": "ydb",
        "scopeName": "source.ydb",
        "path": "./syntaxes/ydb.tmLanguage.json"
      },
      {
        "language": "yamd",
        "scopeName": "text.yamd",
        "path": "./syntaxes/yamd.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter": "yaml",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.tsx": "typescriptreact",
          "meta.embedded.block.jsx": "javascriptreact",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.scss": "scss",
          "meta.embedded.block.java": "java",
          "meta.embedded.block.c": "c",
          "meta.embedded.block.cpp": "cpp",
          "meta.embedded.block.csharp": "csharp",
          "meta.embedded.block.go": "go",
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.ruby": "ruby",
          "meta.embedded.block.php": "php",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.xml": "xml",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.diff": "diff",
          "meta.embedded.block.dockerfile": "dockerfile",
          "meta.embedded.block.powershell": "powershell"
        }
      }
    ],
    "snippets": [
      {
        "language": "yamd",
        "path": "./snippets/yamd.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "yamd.openPreview",
