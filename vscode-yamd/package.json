    "menus": {
      "editor/title": [
        {
          "command": "yamd.openPreviewToSide",
          "when": "editorLangId == yamd",
          "group": "navigation"
        },
        {
          "command": "yamd.exportHtml",
          "group": "yamd_export@1",
          "when": "resourceLangId == yamd"
        },
        {
          "command": "yamd.exportPdf",
          "group": "yamd_export@2",
          "when": "resourceLangId == yamd"
        },
        {
          "command": "yamd.exportDocx",
          "group": "yamd_export@3",
          "when": "resourceLangId == yamd"
        },
        {
          "command": "yamd.exportSlides",
          "group": "yamd_export@4",
          "when": "resourceLangId == yamd"
        },
        {
          "command": "yamd.toggleQuiz",
          "group": "yamd_study@1",
          "when": "resourceLangId == yamd"
        },
        {
          "command": "yamd.showSource",
          "when": "activeCustomEditorId == yamd.editor",
          "group": "navigation"
        },
        {
          "command": "yamd.lockPreview",
          "when": "(activeWebviewPanelId == yamd.preview || activeCustomEditorId == yamd.editor) && !yamd.previewLocked",
          "group": "navigation"
        },
        {
          "command": "yamd.unlockPreview",
          "when": "(activeWebviewPanelId == yamd.preview || activeCustomEditorId == yamd.editor) && yamd.previewLocked",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "yamd.openPreview",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.openPreviewToSide",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.toggleBold",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.toggleItalic",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.toggleUnderline",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.toggleStrikethrough",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.toggleHighlight",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.toggleCode",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.convertFromMarkdown",
          "when": "editorLangId == yamd || editorLangId == markdown"
        },
        {
          "command": "yamd.openMarkdownAsYamd",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.insertTemplate",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.previousDailyNote",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.nextDailyNote",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.linkMentionFromView",
          "when": "false"
        },
        {
          "command": "yamd.addDatabaseToNote",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.openPreviewInEditor",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.showSource",
          "when": "activeCustomEditorId == yamd.editor"
        },
        {
          "command": "yamd.toggleEditorMode",
          "when": "editorLangId == yamd || activeCustomEditorId == yamd.editor"
        },
        {
          "command": "yamd.lockPreview",
          "when": "!yamd.previewLocked"
        },
        {
          "command": "yamd.unlockPreview",
          "when": "yamd.previewLocked"
        },
        {
          "command": "yamd.toggleLivePreview",
          "when": "editorLangId == yamd"
        },
        {
          "command": "yamd.openWidget",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.nameBlock",
          "when": "editorLangId == markdown"
        },
        {
          "command": "yamd.insertWidget",
          "when": "editorLangId == markdown"
        }
      ],
      "file/newFile": [
        {
          "command": "yamd.newNote"
        }
      ],
      "explorer/context": [
        {
          "command": "yamd.newNoteMenu",
          "when": "explorerResourceIsFolder",
          "group": "navigation@5"
        },
        {
          "command": "yamd.openMarkdownAsYamd",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@90"
        },
        {
          "command": "yamd.openInSqliteViewer",
          "when": "resourceExtname == .sqlite || resourceExtname == .sqlite3 || resourceExtname == .db",
          "group": "navigation@91"
        },
        {
          "command": "yamd.newStudyNote",
          "group": "yamd@1",
          "when": "explorerResourceIsFolder || explorerResourceIsRoot"
        }
      ],
      "view/title": [
        {
          "command": "yamd.newNoteMenu",
          "when": "view == yamd.backlinks",
          "group": "navigation@1"
        },
        {
          "command": "yamd.openGraph",
          "when": "view == yamd.backlinks",
          "group": "navigation"
        },
        {
          "command": "yamd.openTodayDailyNote",
          "when": "view == yamd.backlinks",
          "group": "navigation"
        },
        {
          "command": "yamd.chooseConsoleDatabase",
          "when": "view == yamd.sqlConsole",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "yamd.linkMentionFromView",
          "when": "view == yamd.backlinks && viewItem == unlinkedMention",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "yamd.acceptAllChanges",
          "group": "yamd_review@1",
          "when": "resourceLangId == yamd"
        },
        {
          "command": "yamd.rejectAllChanges",
          "group": "yamd_review@2",
          "when": "resourceLangId == yamd"
        },
        {
          "command": "yamd.addCitation",
          "group": "yamd_study@1",
          "when": "resourceLangId == yamd"
        },
        {
          "command": "yamd.insertSymbol",
          "group": "yamd_study@2",
          "when": "resourceLangId == yamd"
        },
        {
          "command": "yamd.insertPdfReference",
          "group": "yamd_study@3",
          "when": "resourceLangId == yamd"
        }
      ]
    },
    "keybindings": [
      {
        "command": "yamd.insertMenu",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.insertLink",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.insertEmbed",
        "key": "ctrl+alt+shift+k",
        "mac": "cmd+alt+shift+k",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.closeBlock",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.jumpToMatchingFence",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.acceptChangeAtCursor",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.rejectChangeAtCursor",
        "key": "ctrl+alt+shift+y",
        "mac": "cmd+alt+shift+y",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == yamd"
      },
      {
        "command": "yamd.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == yamd"
      },
      {
        "command": "yamd.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.toggleUnderline",
        "key": "ctrl+u",
        "mac": "cmd+u",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.toggleStrikethrough",
        "key": "alt+s",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.toggleHighlight",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.toggleCode",
        "key": "ctrl+`",
        "mac": "cmd+`",
        "when": "editorTextFocus && editorLangId == yamd"
      },
      {
        "command": "yamd.onEnter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == yamd && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && !editorHasMultipleSelections && vim.mode != 'Normal' && vim.mode != 'Visual' && vim.mode != 'VisualLine' && config.yamd.editor.listContinuation"
      },
      {
        "command": "yamd.quickSwitcher",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "yamd.toggleEditorMode",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId == yamd || activeCustomEditorId == yamd.editor"
      }
    ],
    "configuration": {
      "title": "YAMD",
      "properties": {
        "yamd.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Report YAMD diagnostics in the Problems panel."
        },
        "yamd.diagnostics.ignore": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Y\\d{3}$"
          },
          "default": [],
          "description": "Diagnostic codes to hide, for example [\"Y707\"]."
        },
        "yamd.editor.listContinuation": {
          "type": "boolean",
          "default": true,
          "description": "Continue lists when pressing Enter at the end of a list item."
        },
        "yamd.index.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns (relative to the workspace folder) for notes to leave out of the index, for example \"archive/**\"."
        },
        "yamd.dailyNotes.folder": {
          "type": "string",
          "default": "daily",
          "description": "Folder for daily notes, relative to the workspace folder."
        },
        "yamd.dailyNotes.format": {
          "type": "string",
          "default": "YYYY-MM-DD",
          "description": "File name format for daily notes. Tokens: YYYY, MM, DD, HH, mm."
        },
        "yamd.dailyNotes.template": {
          "type": "string",
          "default": "",
          "description": "Template for new daily notes, relative to the workspace folder, for example \"templates/daily.yamd\"."
        },
        "yamd.templates.folder": {
          "type": "string",
          "default": "templates",
          "description": "Folder that holds templates for \"YAMD: Insert Template\" and \"YAMD: New Note from Template\". Notes in it aren't indexed."
        },
        "yamd.queries.timeout": {
          "type": "number",
          "default": 2,
          "minimum": 0.1,
          "description": "Seconds a query from a document may run before it is stopped (Y952)."
        },
        "yamd.queries.maxRows": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Most rows a view or query shows."
        },
        "yamd.databases.maxFileSize": {
          "type": "number",
          "default": 100,
          "description": "Database files larger than this many megabytes aren't loaded for previews."
        },
        "yamd.newNote.timestampFormat": {
          "type": "string",
          "default": "YYYY-MM-DD-HHmm",
          "description": "File name for \"New Timestamped Note\". Tokens: YYYY, MM, DD, HH, mm."
        },
        "yamd.newNote.lang": {
          "type": "string",
          "default": "en",
          "description": "The \"lang\" value written into new notes' front matter."
        },
        "yamd.sqlite.viewer": {
          "type": "string",
          "default": "",
          "description": "Custom editor (view type) used by \"Open in SQLite Viewer\". Set when you choose one."
        },
        "yamd.preview.maxSizeKB": {
          "type": "number",
          "default": 8192,
          "minimum": 64,
          "description": "Notes larger than this many kilobytes aren't previewed, to keep the editor responsive. Large notes are parsed in small steps and only the parts you edit are parsed again."
        },
        "yamd.study.newCardsPerDay": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Maximum number of new (unseen) flashcards shown per review session."
        },
        "yamd.study.pomodoroMinutes": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "description": "Default study-timer session length in minutes."
        },
        "yamd.study.logToDailyNote": {
          "type": "boolean",
          "default": true,
          "description": "Append a line to the daily note when a study-timer session finishes."
        },
        "yamd.study.staleAfterDays": {
          "type": "number",
          "default": 14,
          "minimum": 1,
          "description": "Number of days without a review before a topic is considered stale in the dashboard."
        },
        "yamd.preview.startLocked": {
          "type": "boolean",
          "default": false,
          "description": "Open previews locked (read-only): boards, tasks and database views can't be changed from the preview until unlocked."
        },
        "yamd.livePreview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render markup in the editor like Obsidian's Live Preview: syntax is hidden or restyled away from the cursor and shown on the line you are editing."
        },
        "yamd.livePreview.markers": {
          "type": "string",
          "enum": [
            "hide",
            "dim"
          ],
          "default": "hide",
          "description": "What happens to syntax characters (such as ** and #) away from the cursor: hide them, or only dim them."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "yamd.backlinks",
        "contents": "Open a YAMD note to see the notes that link to it.\n[New Note](command:yamd.newNote)\n[New Timestamped Note](command:yamd.newTimestampNote)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yamd",
          "title": "YAMD",
          "icon": "media/yamd-activity.svg"
        }
      ]
    },
    "views": {
      "yamd": [
        {
          "id": "yamd.backlinks",
          "name": "Backlinks"
        },
        {
          "id": "yamd.tags",
          "name": "Tags"
        },
        {
          "id": "yamd.properties",
          "name": "Properties",
          "type": "webview"
        },
        {
          "id": "yamd.sqlConsole",
          "name": "SQL Console",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "yamd.editor",
        "displayName": "YAMD Preview",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.yamd"
          },
          {
            "filenamePattern": "*.ymd"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-grammar.mjs && node esbuild.mjs",
    "watch": "node scripts/build-grammar.mjs && node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "package": "npm run typecheck && npm test && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "node scripts/build-grammar.mjs && node esbuild.mjs --production"
  },
