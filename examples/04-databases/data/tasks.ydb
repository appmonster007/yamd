# A YAMD text database. It diffs and merges one row at a time in git.
yamdb: 0.1
name: Tasks

properties:
  Title: title
  Status:
    type: status
    options: [Todo, Doing, Done]
  Priority:
    type: select
    options: [Low, Medium, High]
  Tags:
    type: multi_select
    options: [frontend, backend, design, docs]
  Owner: person
  Started: date
  Due: date
  Points: number
  Blocked: checkbox
  Link: url
  Project:
    type: relation
    database: projects.ydb
  Overdue:
    type: formula
    expression: "Due < date('now') AND Status != 'Done'"
  Created: created_time
  Updated: updated_time

views:
  Open:
    type: table
    filter: "Status != 'Done'"
    sort: [Due]
    columns: [Title, Status, Priority, Owner, Due]
  By owner:
    type: table
    group: Owner
    columns: [Title, Status, Due]
  Calendar:
    type: calendar
    date: Due
  Roadmap:
    type: timeline
    date: Started
    date-end: Due
    group: Owner

